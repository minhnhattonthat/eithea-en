[
 {
  "id": "KA_SHI08:0000",
  "kind": "msg",
  "speaker": "",
  "jp": "　火竜城２階中央廊下",
  "en": ""
 },
 {
  "id": "KA_SHI08:0001",
  "kind": "msg",
  "speaker": "ひかる",
  "jp": "新見くん……",
  "en": ""
 },
 {
  "id": "KA_SHI08:0002",
  "kind": "choice",
  "speaker": "",
  "jp": "　話をする\n　話をしない",
  "en": "Talk\nDon't talk"
 },
 {
  "id": "KA_SHI08:0003",
  "kind": "msg",
  "speaker": "ひかる",
  "jp": "なぜみんな、\nすぐに戦おうとするんでしょう……",
  "en": ""
 },
 {
  "id": "KA_SHI08:0004",
  "kind": "msg",
  "speaker": "ひかる",
  "jp": "話し合いとか、\nもっといい方法があると思うんですけど……",
  "en": ""
 },
 {
  "id": "KA_SHI08:0005",
  "kind": "msg",
  "speaker": "ひかる",
  "jp": "新見くんは、どう思います？",
  "en": ""
 },
 {
  "id": "KA_SHI08:0006",
  "kind": "choice",
  "speaker": "",
  "jp": "　他にいい方法があるはず\n　戦うしかないだろう",
  "en": ""
 },
 {
  "id": "KA_SHI08:0007",
  "kind": "msg",
  "speaker": "ひかる",
  "jp": "そうですよね！",
  "en": ""
 },
 {
  "id": "KA_SHI08:0008",
  "kind": "msg",
  "speaker": "ひかる",
  "jp": "なんでも暴力で解決しようなんて、\n間違ってますよね。",
  "en": ""
 },
 {
  "id": "KA_SHI08:0009",
  "kind": "msg",
  "speaker": "ひかる",
  "jp": "よかった、新見くんも同じで……",
  "en": ""
 },
 {
  "id": "KA_SHI08:0010",
  "kind": "msg",
  "speaker": "ひかる",
  "jp": "そうなんですか？\nでもわたし、それってすごく\nさびしい考えだと思います……",
  "en": ""
 },
 {
  "id": "KA_SHI08:0011",
  "kind": "msg",
  "speaker": "ユカ",
  "jp": "翔！\n私、許せない！",
  "en": ""
 },
 {
  "id": "KA_SHI08:0012",
  "kind": "choice",
  "speaker": "",
  "jp": "　話をする\n　話をしない",
  "en": "Talk\nDon't talk"
 },
 {
  "id": "KA_SHI08:0013",
  "kind": "msg",
  "speaker": "翔",
  "jp": "どうしたんだ？\nユカ、落ちつけよ。",
  "en": ""
 },
 {
  "id": "KA_SHI08:0014",
  "kind": "msg",
  "speaker": "ユカ",
  "jp": "落ちついてられないよ！",
  "en": ""
 },
 {
  "id": "KA_SHI08:0015",
  "kind": "msg",
  "speaker": "ユカ",
  "jp": "これって何なの？\nメチャクチャだよ！",
  "en": ""
 },
 {
  "id": "KA_SHI08:0016",
  "kind": "msg",
  "speaker": "ユカ",
  "jp": "私、許せない……\nアゼルのこと、絶対に許さないんだから！",
  "en": ""
 },
 {
  "id": "KA_SHI08:0017",
  "kind": "msg",
  "speaker": "ひかる",
  "jp": "新見くん……",
  "en": ""
 },
 {
  "id": "KA_SHI08:0018",
  "kind": "choice",
  "speaker": "",
  "jp": "　話をする\n　話をしない",
  "en": "Talk\nDon't talk"
 },
 {
  "id": "KA_SHI08:0019",
  "kind": "msg",
  "speaker": "ひかる",
  "jp": "イムルって、いい人ですよね。\n明るくて、優しくて……\n新見くんも、そう思いませんか？",
  "en": ""
 },
 {
  "id": "KA_SHI08:0020",
  "kind": "choice",
  "speaker": "",
  "jp": "　そうだな\n　いいや",
  "en": ""
 },
 {
  "id": "KA_SHI08:0021",
  "kind": "msg",
  "speaker": "ひかる",
  "jp": "ですよね！\n早く、お母さんを助けてあげたいですね。",
  "en": ""
 },
 {
  "id": "KA_SHI08:0022",
  "kind": "msg",
  "speaker": "ひかる",
  "jp": "そうですか……？\nわたしは、そんなこと無いと思いますけど……",
  "en": ""
 },
 {
  "id": "KA_SHI08:0023",
  "kind": "msg",
  "speaker": "ルー",
  "jp": "翔……いま……いい？",
  "en": ""
 },
 {
  "id": "KA_SHI08:0024",
  "kind": "choice",
  "speaker": "",
  "jp": "　話をする\n　話をしない",
  "en": "Talk\nDon't talk"
 },
 {
  "id": "KA_SHI08:0025",
  "kind": "msg",
  "speaker": "ルー",
  "jp": "こんなこと、\n早く終わらせないといけないよね……",
  "en": ""
 },
 {
  "id": "KA_SHI08:0026",
  "kind": "msg",
  "speaker": "ルー",
  "jp": "おかしいよね。",
  "en": ""
 },
 {
  "id": "KA_SHI08:0027",
  "kind": "msg",
  "speaker": "ルー",
  "jp": "最初は、火竜族なんて\nどうなってもいいと思ってた。",
  "en": ""
 },
 {
  "id": "KA_SHI08:0028",
  "kind": "msg",
  "speaker": "ルー",
  "jp": "けど、今はちがうの……",
  "en": ""
 }
]
