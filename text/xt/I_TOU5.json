  "en": ""
 },
 {
  "id": "I_TOU5:0006",
  "kind": "msg",
  "speaker": "ユカ",
  "jp": "……翔、この間はごめんね。\n神託所のとこで、あんなこと言っちゃってさ……",
  "en": ""
 },
 {
  "id": "I_TOU5:0007",
  "kind": "msg",
  "speaker": "ユカ",
  "jp": "ごめんね……私、\nあの……ちょっとイライラしてて……",
  "en": ""
 },
 {
  "id": "I_TOU5:0008",
  "kind": "msg",
  "speaker": "ユカ",
  "jp": "翔。\nお願いだから、許して……ね？",
  "en": ""
 },
 {
  "id": "I_TOU5:0009",
  "kind": "choice",
  "speaker": "",
  "jp": "　許す\n　許さない",
  "en": ""
 },
 {
  "id": "I_TOU5:0010",
  "kind": "msg",
  "speaker": "翔",
  "jp": "もう何とも思ってないよ。",
  "en": ""
 },
 {
  "id": "I_TOU5:0011",
  "kind": "msg",
  "speaker": "翔",
  "jp": "ただ、のぞき見するのだけはやめろよ。",
  "en": ""
 },
 {
  "id": "I_TOU5:0012",
  "kind": "msg",
  "speaker": "ユカ",
  "jp": "わーいっ！　ありがと、翔！\nごめんね、ホントに……",
  "en": ""
 },
 {
  "id": "I_TOU5:0013",
  "kind": "msg",
  "speaker": "翔",
  "jp": "許すわけないだろ！？",
  "en": ""
 },
 {
  "id": "I_TOU5:0014",
  "kind": "msg",
  "speaker": "翔",
  "jp": "村のオキテを破りかけたんだぞ！",
  "en": ""
 },
 {
  "id": "I_TOU5:0015",
  "kind": "msg",
  "speaker": "ユカ",
  "jp": "だって……だって、怪しかったんだもん！\nなによ、悪いと思って謝ったのに！\nもう、知らないっ！！",
  "en": ""
 }
