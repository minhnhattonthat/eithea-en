 },
 {
  "id": "KA_CHI03:0016",
  "kind": "msg",
  "speaker": "翔",
  "jp": "それぐらいだったら、いつでもいいさ。",
  "en": ""
 },
 {
  "id": "KA_CHI03:0017",
  "kind": "msg",
  "speaker": "翔",
  "jp": "キャンプしてるときにでも声をかけろよ。",
  "en": ""
 },
 {
  "id": "KA_CHI03:0018",
  "kind": "msg",
  "speaker": "ルー",
  "jp": "ほんとッ！？　やったあ！　ありがと、翔！",
  "en": ""
 },
 {
  "id": "KA_CHI03:0019",
  "kind": "msg",
  "speaker": "ルー",
  "jp": "ヤだって言っても、もうダメだよ！\n約束したからね！",
  "en": ""
 },
 {
  "id": "KA_CHI03:0020",
  "kind": "msg",
  "speaker": "ルー",
  "jp": "ねえ、翔……",
