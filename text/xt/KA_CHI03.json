  "speaker": "ユカ",
  "jp": "そ、そうだよね。",
  "en": ""
 },
 {
  "id": "KA_CHI03:0005",
  "kind": "msg",
  "speaker": "ユカ",
  "jp": "仲間、だよね……\nごめんね、ヘンなこと聞いちゃって。\nそれじゃ……",
  "en": ""
 },
 {
  "id": "KA_CHI03:0006",
  "kind": "msg",
