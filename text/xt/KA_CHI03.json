 },
 {
  "id": "KA_CHI03:0007",
  "kind": "choice",
  "speaker": "",
  "jp": "　話をする\n　話をしない",
  "en": ""
 },
 {
  "id": "KA_CHI03:0008",
  "kind": "msg",
  "speaker": "ルー",
  "jp": "まわりに気をつけてね。\nいつ、どこから火竜族がくるか\nわかんないんだから……！",
  "en": ""
 },
 {
  "id": "KA_CHI03:0009",
  "kind": "msg",
  "speaker": "ルー",
  "jp": "翔……いいかな？",
  "en": ""
 },
 {
  "id": "KA_CHI03:0010",
  "kind": "choice",
  "speaker": "",
  "jp": "　話をする\n　話をしない",
  "en": ""
 },
 {
  "id": "KA_CHI03:0011",
  "kind": "msg",
  "speaker": "ルー",
  "jp": "この前の夜は……ありがと。\n翔と話したら、すごく楽になったよ。",
  "en": ""
 },
 {
  "id": "KA_CHI03:0012",
  "kind": "msg",
  "speaker": "翔",
  "jp": "礼なんて言うなよ。\nただ、話をしただけじゃないか。",
  "en": ""
 },
 {
  "id": "KA_CHI03:0013",
  "kind": "msg",
  "speaker": "ルー",
  "jp": "あのさ……また、つきあってくれる？",
  "en": ""
 },
 {
  "id": "KA_CHI03:0014",
  "kind": "msg",
  "speaker": "ルー",
  "jp": "もっと、翔と話したいんだ。\nアイシアのこと……",
