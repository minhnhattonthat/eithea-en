 },
 {
  "id": "KA_CHI03:0026",
  "kind": "msg",
  "speaker": "ルー",
  "jp": "そんなんじゃないの。\nさけられてるって言うのかな……",
  "en": ""
 },
 {
  "id": "KA_CHI03:0027",
  "kind": "msg",
  "speaker": "ルー",
  "jp": "とにかく、ヘンなんだ。\n翔は心当たりある？",
