[
 {
  "id": "I_MORI03:0000",
  "kind": "msg",
  "speaker": "ルー",
  "jp": "どこ行くの？\n村は、そっちじゃないわよ。",
  "en": ""
 },
 {
  "id": "I_MORI03:0001",
  "kind": "msg",
  "speaker": "翔",
  "jp": "……ふう、やっと終わったな。",
  "en": ""
 },
 {
  "id": "I_MORI03:0002",
  "kind": "msg",
  "speaker": "ユカ",
  "jp": "アイシアってさあ、なんでジャームがいるのお？\n……もうヤだよお。",
  "en": ""
 },
 {
  "id": "I_MORI03:0003",
  "kind": "msg",
  "speaker": "ルー",
  "jp": "わたしも知らないよ。",
  "en": ""
 },
 {
  "id": "I_MORI03:0004",
  "kind": "msg",
  "speaker": "ルー",
  "jp": "生まれた時からいたし、\nそんなこと、考えもしなかったわ。",
  "en": ""
 },
 {
  "id": "I_MORI03:0005",
  "kind": "msg",
  "speaker": "ルー",
  "jp": "<10>…<10>…あ、そういえば族長<8>が\n“ジャームは哀しき存在だ”って言ってけど。",
  "en": ""
 },
 {
  "id": "I_MORI03:0006",
  "kind": "msg",
  "speaker": "秋穂",
  "jp": "哀しき存在？\nそれはどういう意味なの？",
  "en": ""
 },
 {
  "id": "I_MORI03:0007",
  "kind": "msg",
  "speaker": "ルー",
  "jp": "わかんないよ。\nあと何かあるとしたら……\n村に伝わっている昔話かな？",
  "en": ""
 },
 {
  "id": "I_MORI03:0008",
  "kind": "msg",
  "speaker": "ルー",
  "jp": "“ジャームは誰かに造られた”って聞いたっけ。",
  "en": ""
 },
 {
  "id": "I_MORI03:0009",
  "kind": "msg",
  "speaker": "秋穂",
  "jp": "その造った“誰か”は聞かなかったの？",
  "en": ""
 },
 {
  "id": "I_MORI03:0010",
  "kind": "msg",
  "speaker": "ルー",
  "jp": "<10>…<10>…ごめん、忘れちゃった。",
  "en": ""
 },
 {
  "id": "I_MORI03:0011",
  "kind": "msg",
  "speaker": "ルー",
  "jp": "ちいさい頃に聞いたものだし、\n昔話っていうかおとぎ話だし。",
  "en": ""
 },
 {
  "id": "I_MORI03:0012",
  "kind": "msg",
  "speaker": "ルー",
  "jp": "それに、話してくれた人は、\nもう<10>…<10>…ううん、何でもない。",
  "en": ""
 },
 {
  "id": "I_MORI03:0013",
  "kind": "msg",
  "speaker": "秋穂",
  "jp": "哀しき存在というのが気になるわね。",
  "en": ""
 },
 {
  "id": "I_MORI03:0014",
  "kind": "msg",
  "speaker": "ルー",
  "jp": "気になるんだったら、村で族長<8>に聞けば？",
  "en": ""
 },
 {
  "id": "I_MORI03:0015",
  "kind": "msg",
  "speaker": "秋穂",
  "jp": "そうね、急ぎましょう。",
  "en": ""
 },
 {
  "id": "I_MORI03:0016",
  "kind": "msg",
  "speaker": "秋穂",
  "jp": "<1>傷薬<8>を手に入れた！",
  "en": ""
 },
 {
  "id": "I_MORI03:0017",
  "kind": "msg",
  "speaker": "秋穂",
  "jp": "<1>傷薬<8>を手に入れた！",
  "en": ""
 }
]
