[
 {
  "id": "GSHOPZ:0000",
  "kind": "msg",
  "speaker": "店員",
  "jp": "あら、いらっしゃい！",
  "en": ""
 },
 {
  "id": "GSHOPZ:0001",
  "kind": "msg",
  "speaker": "店員",
  "jp": "いらっしゃ～い。\n……あら、戻ってきたの？",
  "en": ""
 },
 {
  "id": "GSHOPZ:0002",
  "kind": "msg",
  "speaker": "翔",
  "jp": "ああ。",
  "en": ""
 },
 {
  "id": "GSHOPZ:0003",
  "kind": "msg",
  "speaker": "店員",
  "jp": "そう。\nまたよろしくね！",
  "en": ""
 },
 {
  "id": "GSHOPZ:0004",
  "kind": "choice",
  "speaker": "",
  "jp": "　買い物をする\n　持っている物を売る\n　立ち去る",
  "en": ""
 },
 {
  "id": "GSHOPZ:0005",
  "kind": "msg",
  "speaker": "店員",
  "jp": "ありがとう！",
  "en": ""
 },
 {
  "id": "GSHOPZ:0006",
  "kind": "msg",
  "speaker": "店員",
  "jp": "あら、なにもいらないの？",
  "en": ""
 },
 {
  "id": "GSHOPZ:0007",
  "kind": "msg",
  "speaker": "店員",
  "jp": "ありがとう、またよろしくね。",
  "en": ""
 },
 {
  "id": "GSHOPZ:0008",
  "kind": "msg",
  "speaker": "店員",
  "jp": "そう。\n売りたい物があったら、いつでも持ってきてね。",
  "en": ""
 },
 {
  "id": "GSHOPZ:0009",
  "kind": "choice",
  "speaker": "",
  "jp": "　<1>通貨<8>について\n　<1>アイテム弾<8>について\n　戻る",
  "en": ""
 },
 {
  "id": "GSHOPZ:0010",
  "kind": "msg",
  "speaker": "店員",
  "jp": "アイシアの通貨は\n<1>ＣＡＮ<8>っていうの。",
  "en": ""
 },
 {
  "id": "GSHOPZ:0011",
  "kind": "msg",
  "speaker": "店員",
  "jp": "それはここ\nイオピロスも同じよ。",
  "en": ""
 },
 {
  "id": "GSHOPZ:0012",
  "kind": "msg",
  "speaker": "店員",
  "jp": "……え？　\n<1>ＣＡＮ<8>をどうやって\n手に入れるかって？",
  "en": ""
 },
 {
  "id": "GSHOPZ:0013",
  "kind": "msg",
  "speaker": "店員",
  "jp": "働いて稼ぐに\n決まってるじゃない。",
  "en": ""
 },
 {
  "id": "GSHOPZ:0014",
  "kind": "msg",
  "speaker": "店員",
  "jp": "でもね、危険だけど、\nジャームを倒しても\n手に入るわよ。",
  "en": ""
 },
 {
  "id": "GSHOPZ:0015",
  "kind": "msg",
  "speaker": "店員",
  "jp": "強いジャームほど、\n<1>ＣＡＮ<8>をたくさん持ってるわ。\n死なない程度にがんばってね。",
  "en": ""
 },
 {
  "id": "GSHOPZ:0016",
  "kind": "msg",
  "speaker": "店員",
  "jp": "アイテム弾のチュートリアルが入ります。",
  "en": ""
 },
 {
  "id": "GSHOPZ:0017",
  "kind": "msg",
  "speaker": "店員",
  "jp": "他に何か聞きたいの？",
  "en": ""
 },
 {
  "id": "GSHOPZ:0018",
  "kind": "msg",
  "speaker": "店員",
  "jp": "あら、もういいの？\nまた買い物に来てね。\nまってるわ。",
  "en": ""
 }
]
