 },
 {
  "id": "KA_SHI03:0001",
  "kind": "msg",
  "speaker": "ユカ",
  "jp": "ねえ、翔。",
  "en": ""
 },
 {
  "id": "KA_SHI03:0002",
  "kind": "choice",
  "speaker": "",
  "jp": "　話をする\n　話をしない",
  "en": ""
 },
 {
  "id": "KA_SHI03:0003",
  "kind": "msg",
  "speaker": "ユカ",
  "jp": "まさか、本当にドラゴンと\n戦うことになるって思わなかったよね。",
  "en": ""
 },
 {
  "id": "KA_SHI03:0004",
  "kind": "msg",
  "speaker": "ユカ",
  "jp": "でも、だいじょうぶだよね！　楽勝だよね！",
  "en": ""
 },
 {
  "id": "KA_SHI03:0005",
  "kind": "choice",
  "speaker": "",
  "jp": "　そうだな\n　まだ油断はできない",
  "en": ""
 },
 {
  "id": "KA_SHI03:0006",
  "kind": "msg",
  "speaker": "ユカ",
  "jp": "でしょ？",
  "en": ""
 },
 {
  "id": "KA_SHI03:0007",
  "kind": "msg",
  "speaker": "ユカ",
  "jp": "これなら女王たちを助けるのも、\nカンタンにいきそうだね！",
  "en": ""
 },
 {
  "id": "KA_SHI03:0008",
  "kind": "msg",
  "speaker": "ユカ",
  "jp": "そ、そうだよね……\nまだ、油断はできないよね。",
  "en": ""
 },
 {
  "id": "KA_SHI03:0009",
  "kind": "msg",
  "speaker": "ユカ",
  "jp": "もっと強い奴が、\nこの奥にいるのかもしれないし……",
  "en": ""
 },
 {
  "id": "KA_SHI03:0010",
  "kind": "msg",
  "speaker": "ユカ",
  "jp": "ねえ、翔！",
  "en": ""
 },
 {
  "id": "KA_SHI03:0011",
  "kind": "choice",
  "speaker": "",
  "jp": "　話をする\n　話をしない",
  "en": ""
 },
 {
  "id": "KA_SHI03:0012",
  "kind": "msg",
  "speaker": "ユカ",
  "jp": "イムルってさ、\n話し方のギャップが激しいよね。",
  "en": ""
 },
 {
  "id": "KA_SHI03:0013",
  "kind": "msg",
  "speaker": "ユカ",
  "jp": "あのヘンテコな\nしゃべり方が、もともとなのかな？",
  "en": ""
 },
 {
  "id": "KA_SHI03:0014",
  "kind": "msg",
  "speaker": "翔",
  "jp": "そうじゃないのか？",
  "en": ""
 },
 {
  "id": "KA_SHI03:0015",
  "kind": "msg",
  "speaker": "ユカ",
  "jp": "だったらヤダなあ……\n王族ってみんな、あんな\nしゃべり方をするのかなあ？",
  "en": ""
 },
 {
  "id": "KA_SHI03:0016",
  "kind": "msg",
  "speaker": "秋穂",
  "jp": "新見くん。",
  "en": ""
 },
 {
  "id": "KA_SHI03:0017",
  "kind": "choice",
  "speaker": "",
  "jp": "　話をする\n　話をしない",
  "en": ""
 },
 {
  "id": "KA_SHI03:0018",
  "kind": "msg",
  "speaker": "秋穂",
  "jp": "まったく、革命だなんて……\n暴力による解決なんて最低の手段なのに……",
  "en": ""
 },
 {
  "id": "KA_SHI03:0019",
  "kind": "msg",
  "speaker": "秋穂",
  "jp": "世界はちがっても、\n人のやることはいっしょなのね。",
  "en": ""
 },
 {
  "id": "KA_SHI03:0020",
  "kind": "msg",
  "speaker": "秋穂",
  "jp": "新見くん、あなたは\nそんな大人になっちゃだめよ。",
  "en": ""
 },
 {
  "id": "KA_SHI03:0021",
  "kind": "msg",
  "speaker": "ルー",
  "jp": "ねえ、翔………",
  "en": ""
 },
 {
  "id": "KA_SHI03:0022",
  "kind": "choice",
  "speaker": "",
  "jp": "　話をする\n　話をしない",
  "en": ""
 },
 {
  "id": "KA_SHI03:0023",
  "kind": "msg",
  "speaker": "ルー",
  "jp": "荒れ放題ね………\nこれが火竜族の本性ってことなのかな………",
  "en": ""
 },
 {
  "id": "KA_SHI03:0024",
  "kind": "choice",
  "speaker": "",
  "jp": "　そうだな\n　それはちがう",
  "en": ""
 },
 {
  "id": "KA_SHI03:0025",
  "kind": "msg",
  "speaker": "ルー",
  "jp": "そうなのかな………\nわたしにはもうわからなくなってきちゃった………",
  "en": ""
 },
 {
  "id": "KA_SHI03:0026",
  "kind": "msg",
  "speaker": "ルー",
  "jp": "そうなのかな………\nわたしにはもうわからなくなってきちゃった………",
