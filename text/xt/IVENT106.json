[
 {
  "id": "IVENT106:0000",
  "kind": "msg",
  "speaker": "翔",
  "jp": "……ここからだ。\nここから始まったんだ。",
  "en": ""
 },
 {
  "id": "IVENT106:0001",
  "kind": "msg",
  "speaker": "翔",
  "jp": "きれいだ……あのときと同じぐらいに……",
  "en": ""
 },
 {
  "id": "IVENT106:0002",
  "kind": "msg",
  "speaker": "翔",
  "jp": "ルー……\nこれが、俺たちの守った世界だぞ……",
  "en": ""
 },
 {
  "id": "IVENT106:0003",
  "kind": "msg",
  "speaker": "翔",
  "jp": "……消えるとき言ったよな。",
  "en": ""
 },
 {
  "id": "IVENT106:0004",
  "kind": "msg",
  "speaker": "翔",
  "jp": "……ここで会ったときから、\n俺を好きになったって……",
  "en": ""
 },
 {
  "id": "IVENT106:0005",
  "kind": "msg",
  "speaker": "翔",
  "jp": "たぶん、俺もそうだ。\nあのときから、ずっとおまえのことを……",
  "en": ""
 },
 {
  "id": "IVENT106:0006",
  "kind": "msg",
  "speaker": "翔",
  "jp": "けど、気づかなかった。\n気づくことができなかった……",
  "en": ""
 },
 {
  "id": "IVENT106:0007",
  "kind": "msg",
  "speaker": "翔",
  "jp": "もっと早くこの気持ちに気づけば、俺はおまえを……",
  "en": ""
 },
 {
  "id": "IVENT106:0008",
  "kind": "msg",
  "speaker": "翔",
  "jp": "……ルー、ごめん。\n俺……俺……何もしてやれなかった……",
  "en": ""
 },
 {
  "id": "IVENT106:0009",
  "kind": "msg",
  "speaker": "ユカ",
  "jp": "……翔。",
  "en": ""
 },
 {
  "id": "IVENT106:0010",
  "kind": "msg",
  "speaker": "ユカ",
  "jp": "もとの世界に戻るための準備が整ったって。\n……そろそろ行こうよ。",
  "en": ""
 },
 {
  "id": "IVENT106:0011",
  "kind": "msg",
  "speaker": "ユカ",
  "jp": "……つらいのはわかるよ。\nけど、アイシアにいてもしょうがないじゃない。\n……ルーはもう、いないんだよ。",
  "en": ""
 },
 {
  "id": "IVENT106:0012",
  "kind": "msg",
  "speaker": "翔",
  "jp": "……わかってる。\nでも、もう少しだけここにいさせてくれ。",
  "en": ""
 },
 {
  "id": "IVENT106:0013",
  "kind": "msg",
  "speaker": "ルー",
  "jp": "……翔。\n……ありがと……",
  "en": ""
 },
 {
  "id": "IVENT106:0014",
  "kind": "msg",
  "speaker": "翔",
  "jp": "空耳……なのか？",
  "en": ""
 },
 {
  "id": "IVENT106:0015",
  "kind": "msg",
  "speaker": "翔",
  "jp": "これは……？",
  "en": ""
 },
 {
  "id": "IVENT106:0016",
  "kind": "msg",
  "speaker": "翔",
  "jp": "エレの樹の光に似てるな。\nルーの好きだった光に……",
  "en": ""
 },
 {
  "id": "IVENT106:0017",
  "kind": "msg",
  "speaker": "翔",
  "jp": "……ルー、またな。",
  "en": ""
 }
]
