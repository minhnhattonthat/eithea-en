[
 {
  "id": "KA_CHI02:0000",
  "kind": "msg",
  "speaker": "ひかる",
  "jp": "あの……　新見くん……",
  "en": ""
 },
 {
  "id": "KA_CHI02:0001",
  "kind": "choice",
  "speaker": "",
  "jp": "　話をする\n　話をしない",
  "en": "Talk\nDon't talk"
 },
 {
  "id": "KA_CHI02:0002",
  "kind": "msg",
  "speaker": "ひかる",
  "jp": "わたし……\n最近、弓の腕が上がったような\n気がするんですけど。",
  "en": ""
 },
 {
  "id": "KA_CHI02:0003",
  "kind": "msg",
  "speaker": "ひかる",
  "jp": "どう思います？",
  "en": ""
 },
 {
  "id": "KA_CHI02:0004",
  "kind": "choice",
  "speaker": "",
  "jp": "　よくなったと思う\n　まだまだだな……",
  "en": ""
 },
 {
  "id": "KA_CHI02:0005",
  "kind": "msg",
  "speaker": "ひかる",
  "jp": "本当ですか！？\nよかった……　わたし、\nみんなの役に立ててるんですね。",
  "en": ""
 },
 {
  "id": "KA_CHI02:0006",
  "kind": "msg",
  "speaker": "ひかる",
  "jp": "そうですか……\nわたし、もっとがんばらないといけませんね。",
  "en": ""
 },
 {
  "id": "KA_CHI02:0007",
  "kind": "msg",
  "speaker": "ひかる",
  "jp": "早く、みんなの役にたたなきゃ……",
  "en": ""
 },
 {
  "id": "KA_CHI02:0008",
  "kind": "msg",
  "speaker": "秋穂",
  "jp": "ねえ、新見くん。",
  "en": ""
 },
 {
  "id": "KA_CHI02:0009",
  "kind": "choice",
  "speaker": "",
  "jp": "　話をする\n　話をしない",
  "en": "Talk\nDon't talk"
 },
 {
  "id": "KA_CHI02:0010",
  "kind": "msg",
  "speaker": "秋穂",
  "jp": "すごいお城だったわね。",
  "en": ""
 },
 {
  "id": "KA_CHI02:0011",
  "kind": "msg",
  "speaker": "秋穂",
  "jp": "あんな大きさだったら、\n城塞といったほうがいいかもしれないけど。",
  "en": ""
 },
 {
  "id": "KA_CHI02:0012",
  "kind": "msg",
  "speaker": "翔",
  "jp": "そうですね。",
  "en": ""
 },
 {
  "id": "KA_CHI02:0013",
  "kind": "msg",
  "speaker": "秋穂",
  "jp": "あれだけのものを造るなんて……",
  "en": ""
 },
 {
  "id": "KA_CHI02:0014",
  "kind": "msg",
  "speaker": "秋穂",
  "jp": "火竜族の歴史は\n戦争の歴史だと聞いたけど、\nあれをみれば納得できるわね。",
  "en": ""
 },
 {
  "id": "KA_CHI02:0015",
  "kind": "msg",
  "speaker": "ひかる",
  "jp": "新見くん……",
  "en": ""
 },
 {
  "id": "KA_CHI02:0016",
  "kind": "choice",
  "speaker": "",
  "jp": "　話をする\n　話をしない",
  "en": "Talk\nDon't talk"
 },
 {
  "id": "KA_CHI02:0017",
  "kind": "msg",
  "speaker": "ひかる",
  "jp": "カーライルであった\nイムルさんって人、おぼえてます……？",
  "en": ""
 },
 {
  "id": "KA_CHI02:0018",
  "kind": "choice",
  "speaker": "",
  "jp": "　君を助けてくれた人？\n　誰、それ？",
  "en": ""
 },
 {
  "id": "KA_CHI02:0019",
  "kind": "msg",
  "speaker": "ひかる",
  "jp": "そうです。\nあの人、ずいぶん親切でしたよね。",
  "en": ""
 },
 {
  "id": "KA_CHI02:0020",
  "kind": "msg",
  "speaker": "ひかる",
  "jp": "もしかしたら火竜族って、\nそんなに悪い人たちばかり\nじゃないのかもしれませんね。",
  "en": ""
 },
 {
  "id": "KA_CHI02:0021",
  "kind": "msg",
  "speaker": "ひかる",
  "jp": "そうですか……",
  "en": ""
 },
 {
  "id": "KA_CHI02:0022",
  "kind": "msg",
  "speaker": "ひかる",
  "jp": "それなら、いいんです。\nごめんなさい、呼び止めたりして……",
  "en": ""
 },
 {
  "id": "KA_CHI02:0023",
  "kind": "msg",
  "speaker": "翔",
  "jp": "そろそろ疲れてきたな……休むか……",
  "en": ""
 },
 {
  "id": "KA_CHI02:0024",
  "kind": "msg",
  "speaker": "翔",
  "jp": "<1>特効薬<8>を手に入れた！",
  "en": ""
 },
 {
  "id": "KA_CHI02:0025",
