[
 {
  "id": "IVENTC07:0000",
  "kind": "msg",
  "speaker": "翔",
  "jp": "ん……あれは……ハーミーか………？",
  "en": ""
 },
 {
  "id": "IVENTC07:0001",
  "kind": "msg",
  "speaker": "翔",
  "jp": "ハーミー……どうしたの？",
  "en": ""
 },
 {
  "id": "IVENTC07:0002",
  "kind": "msg",
  "speaker": "ハーミー",
  "jp": "……あのね、\nおじいちゃんとポーポーのこと、\n思い出してたの。",
  "en": ""
 },
 {
  "id": "IVENTC07:0003",
  "kind": "msg",
  "speaker": "翔",
  "jp": "だいじょうぶだよ。\n二人とも、元気にやってるさ。",
  "en": ""
 },
 {
  "id": "IVENTC07:0004",
  "kind": "msg",
  "speaker": "ハーミー",
  "jp": "なんだか、とってもさびしいの。",
  "en": ""
 },
 {
  "id": "IVENTC07:0005",
  "kind": "msg",
  "speaker": "ハーミー",
  "jp": "さびしいきもちが、伝わってくるの……",
  "en": ""
 },
 {
  "id": "IVENTC07:0006",
  "kind": "msg",
  "speaker": "翔",
  "jp": "こんなに離れてても二人の心が、わかるのか！？",
  "en": ""
 },
 {
  "id": "IVENTC07:0007",
  "kind": "msg",
  "speaker": "ハーミー",
  "jp": "ううん……なんとなく、そんな気がするの。",
  "en": ""
 },
 {
  "id": "IVENTC07:0008",
  "kind": "msg",
  "speaker": "ハーミー",
  "jp": "ハーミー、こんなに離れたことなかったから、\nわかんないの。",
  "en": ""
 },
 {
  "id": "IVENTC07:0009",
  "kind": "msg",
  "speaker": "翔",
  "jp": "きっと、ピエンもポーポーも、さびしいんだよ。",
  "en": ""
 },
 {
  "id": "IVENTC07:0010",
  "kind": "msg",
  "speaker": "翔",
  "jp": "ハーミーと別れてさ。",
  "en": ""
 },
 {
  "id": "IVENTC07:0011",
  "kind": "msg",
  "speaker": "ハーミー",
  "jp": "うん、ハーミーもそう思うの……",
  "en": ""
 },
 {
  "id": "IVENTC07:0012",
  "kind": "msg",
  "speaker": "翔",
  "jp": "だったら、元気をだせよ。\nピエンとポーポーを心配させないためにもな。",
  "en": ""
 },
 {
  "id": "IVENTC07:0013",
  "kind": "msg",
  "speaker": "ハーミー",
  "jp": "うん、そうなの。\nハーミー、元気にするの！",
  "en": ""
 }
]
