 {
  "id": "IVENT15:0002",
  "kind": "msg",
  "speaker": "ユカ",
  "jp": "ん……ちょっと、\nあやしいなって思って、調べてるの。",
  "en": ""
 },
 {
  "id": "IVENT15:0003",
  "kind": "msg",
  "speaker": "翔",
  "jp": "調べてるって……のぞき見だろ？\nバレるとタダじゃすまないぜ。",
  "en": ""
 },
 {
  "id": "IVENT15:0004",
  "kind": "msg",
  "speaker": "ユカ",
  "jp": "えっ！？ちがうよ！\nここには絶対なにか秘密があるよ！\n翔は気にならないの？",
  "en": ""
 },
 {
  "id": "IVENT15:0005",
  "kind": "msg",
  "speaker": "翔",
  "jp": "そりゃあ、気になるさ。",
  "en": ""
 },
 {
  "id": "IVENT15:0006",
  "kind": "msg",
  "speaker": "翔",
  "jp": "でも、コソコソ見るのはよくないぞ。",
  "en": ""
 },
 {
  "id": "IVENT15:0007",
  "kind": "msg",
  "speaker": "ユカ",
  "jp": "じゃあ、翔は堂々と見ろっていうの？",
  "en": ""
 },
 {
  "id": "IVENT15:0008",
  "kind": "msg",
  "speaker": "翔",
  "jp": "いいから、やめろよ！\n俺たちはここに置いてもらっている立場なんだ。\n軽はずみな行動はひかえたほうがいい。",
  "en": ""
 },
 {
  "id": "IVENT15:0009",
  "kind": "msg",
  "speaker": "ユカ",
  "jp": "もう……いいわよ！\n学でも誘って、遊んでくるわ！",
  "en": ""
 },
 {
  "id": "IVENT15:0010",
  "kind": "msg",
  "speaker": "翔",
  "jp": "なんだよ、ユカのやつ……",
