[
 {
  "id": "IVENT22:0000",
  "kind": "msg",
  "speaker": "翔",
  "jp": "あれは伊藤さんじゃないか！\nあの横にいる男は！？",
  "en": ""
 },
 {
  "id": "IVENT22:0001",
  "kind": "msg",
  "speaker": "ひかる",
  "jp": "何をするんですか！　離してください、離して！！\n誰か、助けてェ！！",
  "en": ""
 },
 {
  "id": "IVENT22:0002",
  "kind": "msg",
  "speaker": "？？？",
  "jp": "ち、ちがうんだってば、ベイベー。",
  "en": ""
 },
 {
  "id": "IVENT22:0003",
  "kind": "msg",
  "speaker": "？？？",
  "jp": "しょうがないなあ、こっちにおいで。",
  "en": ""
 },
 {
  "id": "IVENT22:0004",
  "kind": "msg",
  "speaker": "翔",
  "jp": "まてっ！！　伊藤さんをどうするつもりだ！？",
  "en": ""
 },
 {
  "id": "IVENT22:0005",
  "kind": "msg",
  "speaker": "？？？",
  "jp": "あはん？　キミは誰だい？\nベイベーと取り込み中なんだ。",
  "en": ""
 },
 {
  "id": "IVENT22:0006",
  "kind": "msg",
  "speaker": "？？？",
  "jp": "スウィートな時間をじゃましないでほしいなあ。",
  "en": ""
 },
 {
  "id": "IVENT22:0007",
  "kind": "msg",
  "speaker": "翔",
  "jp": "その子から離れろ！！",
  "en": ""
 },
 {
  "id": "IVENT22:0008",
  "kind": "msg",
  "speaker": "翔",
  "jp": "伊藤さん、だいじょうぶか！？",
  "en": ""
 },
 {
  "id": "IVENT22:0009",
  "kind": "msg",
  "speaker": "翔",
  "jp": "ケガはなかった？\nなにか、ヘンなことは……",
  "en": ""
 },
 {
  "id": "IVENT22:0010",
  "kind": "msg",
  "speaker": "ひかる",
  "jp": "やだやだッ！\nさわらないで！",
  "en": ""
 },
 {
  "id": "IVENT22:0011",
  "kind": "msg",
  "speaker": "ひかる",
  "jp": "助けて……新見くんッ！！",
  "en": ""
 },
 {
  "id": "IVENT22:0012",
  "kind": "msg",
  "speaker": "翔",
  "jp": "……え？\nあの……本人なんだけど……",
  "en": ""
 },
 {
  "id": "IVENT22:0013",
  "kind": "msg",
  "speaker": "ひかる",
  "jp": "あ……あれ？\n……あの……いつのまに……？",
  "en": ""
 },
 {
  "id": "IVENT22:0014",
  "kind": "msg",
  "speaker": "翔",
  "jp": "知らないヤツに襲われてたのを、\n助けたときからだけど。",
  "en": ""
 },
 {
  "id": "IVENT22:0015",
  "kind": "msg",
  "speaker": "ひかる",
  "jp": "……え？\nでも、わたし、別の人に助けられたような気が……",
  "en": ""
 },
 {
  "id": "IVENT22:0016",
  "kind": "msg",
  "speaker": "？？？",
  "jp": "……ああん、それって僕さ。",
  "en": ""
 },
 {
  "id": "IVENT22:0017",
  "kind": "msg",
  "speaker": "？？？",
  "jp": "ほおおおう、\n玉の肌に傷がついちゃったじゃないか。",
  "en": ""
 },
 {
  "id": "IVENT22:0018",
  "kind": "msg",
  "speaker": "ひかる",
  "jp": "……あ！\nこ、この人です……",
  "en": ""
 },
 {
  "id": "IVENT22:0019",
  "kind": "msg",
  "speaker": "ひかる",
  "jp": "この人が……わたしを助けてくれたんです……",
  "en": ""
 },
 {
  "id": "IVENT22:0020",
  "kind": "msg",
  "speaker": "翔",
  "jp": "ええっ！？\nそ、そうなんだ……",
  "en": ""
 },
 {
  "id": "IVENT22:0021",
  "kind": "msg",
  "speaker": "？？？",
  "jp": "すべてトゥルース。\nベイベーを助けたのは、この僕だよ。",
  "en": ""
 },
 {
  "id": "IVENT22:0022",
  "kind": "msg",
  "speaker": "ひかる",
  "jp": "……みんなを探して、ここの前まで来たんです。",
  "en": ""
 },
 {
  "id": "IVENT22:0023",
  "kind": "msg",
  "speaker": "ひかる",
  "jp": "そうしたら、男の人にからまれて……",
  "en": ""
 },
 {
  "id": "IVENT22:0024",
  "kind": "msg",
  "speaker": "？？？",
  "jp": "それがほんの数分前さ。\n悲鳴をあげるヒロイン…ベイベー。",
  "en": ""
 },
 {
  "id": "IVENT22:0025",
  "kind": "msg",
  "speaker": "？？？",
  "jp": "僕的には助けるしかないだろ？",
  "en": ""
 },
 {
  "id": "IVENT22:0026",
  "kind": "msg",
  "speaker": "？？？",
  "jp": "危険をかえりみず、ベイベーを救う騎士。",
  "en": ""
 },
 {
  "id": "IVENT22:0027",
  "kind": "msg",
  "speaker": "？？？",
  "jp": "ああん、\n高貴な心の持ち主、それが僕なのさ！",
  "en": ""
 },
 {
  "id": "IVENT22:0028",
  "kind": "msg",
  "speaker": "翔",
  "jp": "……なんだコイツは？",
  "en": ""
 },
 {
  "id": "IVENT22:0029",
  "kind": "msg",
  "speaker": "？？？",
  "jp": "しかしベイベー、よほど怖かったんだろうね。",
  "en": ""
 },
 {
  "id": "IVENT22:0030",
  "kind": "msg",
  "speaker": "？？？",
  "jp": "助けた後も、どうにも落ちついてくれなくて……",
  "en": ""
 },
 {
  "id": "IVENT22:0031",
  "kind": "msg",
  "speaker": "？？？",
  "jp": "しょうがないから、<1>クラブ<8>の中に入ろうとしたんだ。",
  "en": ""
 },
 {
  "id": "IVENT22:0032",
  "kind": "msg",
  "speaker": "？？？",
  "jp": "あとは、そこの彼が見たとおりさ。",
  "en": ""
 },
 {
  "id": "IVENT22:0033",
  "kind": "msg",
  "speaker": "ひかる",
  "jp": "ごめんなさい、わたし……混乱してたから……",
  "en": ""
 },
 {
  "id": "IVENT22:0034",
  "kind": "msg",
  "speaker": "？？？",
  "jp": "ああん、気にしないで、マイ・スウィート。",
  "en": ""
 },
 {
  "id": "IVENT22:0035",
  "kind": "msg",
  "speaker": "？？？",
  "jp": "よかったね、恋人に助けにきてもらえて。",
  "en": ""
 },
 {
  "id": "IVENT22:0036",
  "kind": "msg",
  "speaker": "？？？",
  "jp": "僕としては、\nキミの騎士になれなくて残念だけどさ。",
  "en": ""
 },
 {
  "id": "IVENT22:0037",
  "kind": "msg",
  "speaker": "ひかる",
  "jp": "……え！\n……あの……そんなのじゃ……\nあ……わたし……でも……",
  "en": ""
 },
 {
  "id": "IVENT22:0038",
  "kind": "msg",
  "speaker": "翔",
  "jp": "悪かったよ。\n事情を知らなかったから……",
  "en": ""
 },
 {
  "id": "IVENT22:0039",
  "kind": "msg",
  "speaker": "？？？",
  "jp": "ベイベーに免じて、今回はノンプロブレム。\nけど、次はないよ。返事は？",
  "en": ""
 },
 {
  "id": "IVENT22:0040",
  "kind": "msg",
  "speaker": "翔",
  "jp": "あ、ああ、わかったよ。\nほんとにありがとう。",
  "en": ""
 },
 {
  "id": "IVENT22:0041",
  "kind": "msg",
  "speaker": "？？？",
  "jp": "それじゃ、グッバイ、ベイベー。\n騎士は野暮をしないものさ。",
  "en": ""
 },
 {
  "id": "IVENT22:0042",
  "kind": "msg",
  "speaker": "ひかる",
  "jp": "あの……傷の手当ては……",
  "en": ""
 },
 {
  "id": "IVENT22:0043",
  "kind": "msg",
  "speaker": "？？？",
  "jp": "キミの笑顔がなによりの薬さ。",
  "en": ""
 },
 {
  "id": "IVENT22:0044",
  "kind": "msg",
  "speaker": "？？？",
  "jp": "そのかわりに、\nベイベーの名前を教えてくれるかい？",
  "en": ""
 },
 {
  "id": "IVENT22:0045",
  "kind": "msg",
  "speaker": "ひかる",
  "jp": "……わたしは、ひかる。\n伊藤　ひかる……です……",
  "en": ""
 },
 {
  "id": "IVENT22:0046",
  "kind": "msg",
  "speaker": "？？？",
  "jp": "ひかる、か。\nああん、聞くだけで抱きしめたくなるよ。",
  "en": ""
 },
 {
  "id": "IVENT22:0047",
  "kind": "msg",
  "speaker": "？？？",
  "jp": "また会えるといいね。\n……今度はキミだけでさ。",
  "en": ""
 },
 {
  "id": "IVENT22:0048",
  "kind": "msg",
  "speaker": "ひかる",
  "jp": "…………",
  "en": ""
 },
 {
  "id": "IVENT22:0049",
  "kind": "msg",
  "speaker": "翔",
  "jp": "変わりものだけど、悪い奴じゃないみたいだな。\n<10>さあ、行こうか。\nみんな、アルバイジャンの家でまってるよ。",
  "en": ""
 },
 {
  "id": "IVENT22:0050",
  "kind": "msg",
  "speaker": "翔",
  "jp": "みんな、伊藤さんを見つけたぞ！",
  "en": ""
 },
 {
  "id": "IVENT22:0051",
  "kind": "msg",
  "speaker": "ひかる",
  "jp": "……ごめんなさい。\n町の中で迷ってしまって……それで――",
  "en": ""
 },
 {
  "id": "IVENT22:0052",
  "kind": "msg",
  "speaker": "ユカ",
  "jp": "ひかる！\nあんた、なにやってんのよ！！",
  "en": ""
 },
 {
  "id": "IVENT22:0053",
  "kind": "msg",
  "speaker": "ユカ",
  "jp": "どれだけ心配したか、わかってるの！？",
  "en": ""
 },
 {
  "id": "IVENT22:0054",
  "kind": "msg",
  "speaker": "ひかる",
  "jp": "……ごめんなさい。",
  "en": ""
 },
 {
  "id": "IVENT22:0055",
  "kind": "msg",
  "speaker": "ユカ",
  "jp": "ごめんなさいじゃないわよ！",
  "en": ""
 },
 {
  "id": "IVENT22:0056",
  "kind": "msg",
  "speaker": "ユカ",
  "jp": "先生もルーも翔も、\nみんな、ひかるのこと、ずっと探してたんだよ！",
  "en": ""
 },
 {
  "id": "IVENT22:0057",
  "kind": "msg",
  "speaker": "ユカ",
  "jp": "わかる？　みんなにどれだけ迷惑かけたか、\nほんとうにわかってんの！？",
  "en": ""
 },
 {
  "id": "IVENT22:0058",
  "kind": "msg",
  "speaker": "ひかる",
  "jp": "……ごめ……うう……",
  "en": ""
 },
 {
  "id": "IVENT22:0059",
  "kind": "msg",
  "speaker": "ユカ",
  "jp": "……でも、私も謝らなきゃ……",
  "en": ""
 },
 {
  "id": "IVENT22:0060",
  "kind": "msg",
  "speaker": "ユカ",
  "jp": "あのとき、私が気づいてあげたら……",
  "en": ""
 },
 {
  "id": "IVENT22:0061",
  "kind": "msg",
  "speaker": "ユカ",
  "jp": "もっと、ちゃんと注意して\nあげていたら……ごめんね。",
  "en": ""
 },
 {
  "id": "IVENT22:0062",
  "kind": "msg",
  "speaker": "ユカ",
  "jp": "私、友達失格だよ……",
  "en": ""
 },
 {
  "id": "IVENT22:0063",
  "kind": "msg",
  "speaker": "ひかる",
  "jp": "ちがう！　ちがうよ！\nもっとしっかりしてたら……\nわたしがしっかりしてたら……",
  "en": ""
 },
 {
  "id": "IVENT22:0064",
  "kind": "msg",
  "speaker": "ひかる",
  "jp": "だったら、ユカに迷惑かけずにすんだんだもの！",
  "en": ""
 },
 {
  "id": "IVENT22:0065",
  "kind": "msg",
  "speaker": "ひかる",
  "jp": "友達失格なのは、わたしのほうだよ……",
  "en": ""
 },
 {
  "id": "IVENT22:0066",
  "kind": "msg",
  "speaker": "ユカ",
  "jp": "ありがと……ひかる、ありがと……",
  "en": ""
 },
 {
  "id": "IVENT22:0067",
  "kind": "msg",
  "speaker": "ひかる",
  "jp": "わたしも……ありがとう。\nユカ、ずっと友達でいてね……",
  "en": ""
 }
]
