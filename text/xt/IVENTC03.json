[
 {
  "id": "IVENTC03:0000",
  "kind": "msg",
  "speaker": "翔",
  "jp": "ユカ、まだ起きていたのか？\nもう寝たほうがいいぞ。",
  "en": ""
 },
 {
  "id": "IVENTC03:0001",
  "kind": "msg",
  "speaker": "ユカ",
  "jp": "……あ、翔……",
  "en": ""
 },
 {
  "id": "IVENTC03:0002",
  "kind": "msg",
  "speaker": "翔",
  "jp": "元気ないな。\nどうしたんだ？",
  "en": ""
 },
 {
  "id": "IVENTC03:0003",
  "kind": "msg",
  "speaker": "ユカ",
  "jp": "……え、そうかな。\nいいこと、あったんだけどなあ……",
  "en": ""
 },
 {
  "id": "IVENTC03:0004",
  "kind": "msg",
  "speaker": "翔",
  "jp": "いいこと？",
  "en": ""
 },
 {
  "id": "IVENTC03:0005",
  "kind": "msg",
  "speaker": "ユカ",
  "jp": "うん、そうだよ。",
  "en": ""
 },
 {
  "id": "IVENTC03:0006",
  "kind": "msg",
  "speaker": "ユカ",
  "jp": "……アルバイジャンのことでさ、\n落ち込んでたでしょ？",
  "en": ""
 },
 {
  "id": "IVENTC03:0007",
  "kind": "msg",
  "speaker": "ユカ",
  "jp": "あのとき、ルーが励ましてくれたよね。",
  "en": ""
 },
 {
  "id": "IVENTC03:0008",
  "kind": "msg",
  "speaker": "ユカ",
  "jp": "……私、うれしかった……",
  "en": ""
 },
 {
  "id": "IVENTC03:0009",
  "kind": "msg",
  "speaker": "ユカ",
  "jp": "すごく……すごく、うれしかったんだ……",
  "en": ""
 },
 {
  "id": "IVENTC03:0010",
  "kind": "msg",
  "speaker": "翔",
  "jp": "じゃあ、なんで元気ないんだ？",
  "en": ""
 },
 {
  "id": "IVENTC03:0011",
  "kind": "msg",
  "speaker": "ユカ",
  "jp": "……わかんない。\n……けど、なんでだろ？",
  "en": ""
 },
 {
  "id": "IVENTC03:0012",
  "kind": "msg",
  "speaker": "ユカ",
  "jp": "急にさびしくなってきちゃって……",
  "en": ""
 },
 {
  "id": "IVENTC03:0013",
  "kind": "msg",
  "speaker": "翔",
  "jp": "…………",
  "en": ""
 },
 {
  "id": "IVENTC03:0014",
  "kind": "msg",
  "speaker": "ユカ",
  "jp": "……アイシアはきれいなとこだよ。",
  "en": ""
 },
 {
  "id": "IVENTC03:0015",
  "kind": "msg",
  "speaker": "ユカ",
  "jp": "ジャームがいること以外、すごく楽しいし。",
  "en": ""
 },
 {
  "id": "IVENTC03:0016",
  "kind": "msg",
  "speaker": "ユカ",
  "jp": "それに、翔<8>といっしょにいられるし……",
  "en": ""
 },
 {
  "id": "IVENTC03:0017",
  "kind": "msg",
  "speaker": "ユカ",
  "jp": "……でも、ダメなの……さびしいの。\nもとの世界に帰りたいの……！",
  "en": ""
 },
 {
  "id": "IVENTC03:0018",
  "kind": "msg",
  "speaker": "翔",
  "jp": "だいじょうぶだって。\nもとの世界には帰れる――え……？",
  "en": ""
 },
 {
  "id": "IVENTC03:0019",
  "kind": "msg",
  "speaker": "ユカ",
  "jp": "……ごめん……少しだけ……\n少しだけ、いいよね……？",
  "en": ""
 },
 {
  "id": "IVENTC03:0020",
  "kind": "msg",
  "speaker": "翔",
  "jp": "……ユカ<8>……",
  "en": ""
 },
 {
  "id": "IVENTC03:0021",
  "kind": "msg",
  "speaker": "ユカ",
  "jp": "……こうしてると、落ちつくの……",
  "en": ""
 },
 {
  "id": "IVENTC03:0022",
  "kind": "msg",
  "speaker": "ユカ",
  "jp": "ごめんね、翔<8>……ごめんね……。",
  "en": ""
 },
 {
  "id": "IVENTC03:0023",
  "kind": "msg",
  "speaker": "ユカ",
  "jp": "がんばるから……明日からがんばるから……",
  "en": ""
 },
 {
  "id": "IVENTC03:0024",
  "kind": "msg",
  "speaker": "ユカ",
  "jp": "だから、今だけ、こうさせて……",
  "en": ""
 }
]
