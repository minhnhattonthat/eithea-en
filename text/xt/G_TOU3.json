[
 {
  "id": "G_TOU3:0000",
  "kind": "msg",
  "speaker": "",
  "jp": "　　月光の塔　　３階",
  "en": ""
 },
 {
  "id": "G_TOU3:0001",
  "kind": "msg",
  "speaker": "",
  "jp": "<1>傷薬<8>を手に入れた！",
  "en": ""
 },
 {
  "id": "G_TOU3:0002",
  "kind": "msg",
  "speaker": "ユカ",
  "jp": "ねえ翔、ちょっといい？",
  "en": ""
 },
 {
  "id": "G_TOU3:0003",
  "kind": "choice",
  "speaker": "",
  "jp": "　話をする\n　話をしない",
  "en": ""
 },
 {
  "id": "G_TOU3:0004",
  "kind": "msg",
  "speaker": "ユカ",
  "jp": "村にいた神官のエウリケってさ、\nなんかヤな感じだよね。",
  "en": ""
 },
 {
  "id": "G_TOU3:0005",
  "kind": "msg",
  "speaker": "ユカ",
  "jp": "翔はあの人のこと、どう思う？",
  "en": ""
 },
 {
  "id": "G_TOU3:0006",
  "kind": "choice",
  "speaker": "",
  "jp": "　俺も気になる\n　別に……",
  "en": ""
 },
 {
  "id": "G_TOU3:0007",
  "kind": "msg",
  "speaker": "ユカ",
  "jp": "やっぱりそうなんだ！\n翔もそう思うよね。",
  "en": ""
 },
 {
  "id": "G_TOU3:0008",
  "kind": "msg",
  "speaker": "ユカ",
  "jp": "だからさ、早くエレボタルを倒して、\nあいつを悔しがらせてやろうよ！",
  "en": ""
 },
 {
  "id": "G_TOU3:0009",
  "kind": "msg",
  "speaker": "ユカ",
  "jp": "えへへ、がんばろうね！",
  "en": ""
 },
 {
  "id": "G_TOU3:0010",
  "kind": "msg",
  "speaker": "ユカ",
  "jp": "ふう～ん、そうなんだ。\n翔って、がまん強いんだね。\nなんか意外だなあ……",
  "en": ""
 },
 {
  "id": "G_TOU3:0011",
  "kind": "msg",
  "speaker": "ルー",
  "jp": "ねえ、翔…",
  "en": ""
 },
 {
  "id": "G_TOU3:0012",
  "kind": "choice",
  "speaker": "",
  "jp": "　話をする\n　話をしない",
  "en": ""
 },
 {
  "id": "G_TOU3:0013",
  "kind": "msg",
  "speaker": "ルー",
  "jp": "この塔の中ってこんなふうになってるのね。\nけっこう暗いわね…",
  "en": ""
 },
 {
  "id": "G_TOU3:0014",
  "kind": "choice",
  "speaker": "",
  "jp": "　恐いのか？\n　手でもつなごうか？",
  "en": ""
 },
 {
  "id": "G_TOU3:0015",
  "kind": "msg",
  "speaker": "ルー",
  "jp": "うっ、ちがうわよ！\nそんな意味で言ったんじゃないってば！",
  "en": ""
 },
 {
  "id": "G_TOU3:0016",
  "kind": "msg",
  "speaker": "ひかる",
  "jp": "……あの、新見くん、少しいいですか？",
  "en": ""
 },
 {
  "id": "G_TOU3:0017",
  "kind": "choice",
  "speaker": "",
  "jp": "　話をする\n　話をしない",
  "en": ""
 },
 {
  "id": "G_TOU3:0018",
  "kind": "msg",
  "speaker": "ひかる",
  "jp": "……わたし、みんなの役にたっているんでしょうか？",
  "en": ""
 },
 {
  "id": "G_TOU3:0019",
  "kind": "msg",
  "speaker": "ひかる",
  "jp": "最近、そればかりが気になるんです……",
  "en": ""
 },
 {
  "id": "G_TOU3:0020",
  "kind": "choice",
  "speaker": "",
  "jp": "　役にたっている\n　もう少しがんばれ",
  "en": ""
 },
 {
  "id": "G_TOU3:0021",
  "kind": "msg",
  "speaker": "ひかる",
  "jp": "あ、ありがとう……\nわたし、すごく気になって……",
  "en": ""
 },
 {
  "id": "G_TOU3:0022",
  "kind": "msg",
  "speaker": "ひかる",
  "jp": "わたし、がんばります……\nみんなのために、わたし自身のために……！",
  "en": ""
 },
 {
  "id": "G_TOU3:0023",
  "kind": "msg",
  "speaker": "ひかる",
  "jp": "<10>…<10>…そうですか。\nやっぱり、そうですよね。",
  "en": ""
 },
 {
  "id": "G_TOU3:0024",
  "kind": "msg",
  "speaker": "ひかる",
  "jp": "<10>…<10>…もっと、がんばります。\n変なこと聞いて、すいません……",
  "en": ""
 },
 {
  "id": "G_TOU3:0025",
  "kind": "msg",
  "speaker": "ルー",
  "jp": "翔、今いい？",
  "en": ""
 },
 {
  "id": "G_TOU3:0026",
  "kind": "choice",
  "speaker": "",
  "jp": "　話をする\n　話をしない",
  "en": ""
 },
 {
  "id": "G_TOU3:0027",
  "kind": "msg",
  "speaker": "ルー",
  "jp": "こんなことに巻き込んでしまって、ごめんね。",
  "en": ""
 },
 {
  "id": "G_TOU3:0028",
  "kind": "msg",
  "speaker": "ルー",
  "jp": "やっぱり、迷惑だよね……？",
  "en": ""
 },
 {
  "id": "G_TOU3:0029",
  "kind": "choice",
  "speaker": "",
  "jp": "　迷惑じゃないよ\n　少しツラいな",
  "en": ""
 },
 {
  "id": "G_TOU3:0030",
  "kind": "msg",
  "speaker": "ルー",
  "jp": "ありがと、翔。\nウソでもうれしいよ。",
  "en": ""
 },
 {
  "id": "G_TOU3:0031",
  "kind": "msg",
  "speaker": "ルー",
  "jp": "頼りにしてるわ。\nがんばってね。",
  "en": ""
 },
 {
  "id": "G_TOU3:0032",
  "kind": "msg",
  "speaker": "ルー",
  "jp": "やっぱり、そうだよね……",
  "en": ""
 },
 {
  "id": "G_TOU3:0033",
  "kind": "msg",
  "speaker": "ルー",
  "jp": "エレボタルを退治したら、\n銃を外す方法も、\nもとの世界に帰る方法も見つかるよ。",
  "en": ""
 },
 {
  "id": "G_TOU3:0034",
  "kind": "msg",
  "speaker": "ルー",
  "jp": "だから、今だけがまんして。\n翔、お願い……",
  "en": ""
 }
]
