  "kind": "msg",
  "speaker": "ルー",
  "jp": "……翔、前に言ったよね。",
  "en": ""
 },
 {
  "id": "IVENT52:0005",
  "kind": "msg",
  "speaker": "ルー",
  "jp": "自分たちは異世界から来た者だって……",
  "en": ""
 },
 {
  "id": "IVENT52:0006",
  "kind": "msg",
  "speaker": "ルー",
  "jp": "……すごくさびしくなった。\n翔がそう言うの聞いて、すごくさびしくなったの……",
  "en": ""
 },
 {
  "id": "IVENT52:0007",
  "kind": "msg",
  "speaker": "ルー",
  "jp": "……なんで、そう思ったんだろ？",
  "en": ""
 },
 {
  "id": "IVENT52:0008",
  "kind": "msg",
  "speaker": "ルー",
  "jp": "わからない……\nほんとにわからない。",
  "en": ""
 },
 {
  "id": "IVENT52:0009",
  "kind": "msg",
  "speaker": "ルー",
  "jp": "けど、すごくさびしくって……\nすごく悲しくって……",
  "en": ""
 },
 {
  "id": "IVENT52:0010",
  "kind": "msg",
  "speaker": "翔",
  "jp": "……ごめん。",
  "en": ""
 },
 {
  "id": "IVENT52:0011",
  "kind": "msg",
  "speaker": "ルー",
  "jp": "……謝らなくていいよ。\n翔が異世界から来たのは本当のことなんだし……",
  "en": ""
 },
 {
  "id": "IVENT52:0012",
  "kind": "msg",
  "speaker": "ルー",
  "jp": "……ごめん。\n少しだけ一人にして……",
  "en": ""
 },
 {
  "id": "IVENT52:0013",
  "kind": "msg",
  "speaker": "ルー",
  "jp": "今は、そうしていたいの……",
  "en": ""
