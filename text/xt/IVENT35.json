  "en": ""
 },
 {
  "id": "IVENT35:0018",
  "kind": "msg",
  "speaker": "翔",
  "jp": "……だいじょうぶか？\nつらかったら、休んでろよ。",
  "en": ""
 },
 {
  "id": "IVENT35:0019",
  "kind": "msg",
  "speaker": "ユカ",
  "jp": "うん……だいじょうぶ……",
