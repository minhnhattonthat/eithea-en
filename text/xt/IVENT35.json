[
 {
  "id": "IVENT35:0000",
  "kind": "msg",
  "speaker": "翔",
  "jp": "まさか、こんなことになるなんて……\nこれからどうすればいいんだ？",
  "en": ""
 },
 {
  "id": "IVENT35:0001",
  "kind": "msg",
  "speaker": "ルー",
  "jp": "とっととユーロリアから出ようよ。",
  "en": ""
 },
 {
  "id": "IVENT35:0002",
  "kind": "msg",
  "speaker": "ルー",
  "jp": "わたしたち、けっこう目立ってるわよ。",
