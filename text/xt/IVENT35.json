 },
 {
  "id": "IVENT35:0012",
  "kind": "msg",
  "speaker": "ユカ",
  "jp": "………え？\nあ…………うん。",
  "en": ""
 },
 {
  "id": "IVENT35:0013",
  "kind": "msg",
  "speaker": "翔",
  "jp": "よし、宿を探そう。\n手分けして探したほうがいいな。",
  "en": ""
 },
 {
  "id": "IVENT35:0014",
  "kind": "msg",
  "speaker": "翔",
  "jp": "見つかったら、ここに戻ってくる。\nそれでいいか？",
  "en": ""
 },
 {
  "id": "IVENT35:0015",
  "kind": "msg",
  "speaker": "秋穂",
  "jp": "わかったわ。\nそれじゃあ、また後でね。",
  "en": ""
 },
 {
  "id": "IVENT35:0016",
  "kind": "msg",
  "speaker": "翔",
  "jp": "……さてと、俺はどこを探そうかな？\nユカ、おまえはどうする？",
  "en": ""
 },
 {
  "id": "IVENT35:0017",
  "kind": "msg",
  "speaker": "ユカ",
