[
 {
  "id": "IVENT12:0000",
  "kind": "msg",
  "speaker": "シャイ",
  "jp": "……相手の動きを読むの。\n予測して、そこに当てる。\nそれが基本で、すべてよ。",
  "en": ""
 },
 {
  "id": "IVENT12:0001",
  "kind": "msg",
  "speaker": "翔",
  "jp": "……練習中か。\n声をかけるのも、悪いな。",
  "en": ""
 },
 {
  "id": "IVENT12:0002",
  "kind": "msg",
  "speaker": "秋穂",
  "jp": "ねえ、シャイ……",
  "en": ""
 },
 {
  "id": "IVENT12:0003",
  "kind": "msg",
  "speaker": "シャイ",
  "jp": "なに？",
  "en": ""
 },
 {
  "id": "IVENT12:0004",
  "kind": "msg",
  "speaker": "秋穂",
  "jp": "あなたとルーなんだけど、何があったの？",
  "en": ""
 },
 {
  "id": "IVENT12:0005",
  "kind": "msg",
  "speaker": "シャイ",
  "jp": "何でそんなことを聞くの？",
  "en": ""
 },
 {
  "id": "IVENT12:0006",
  "kind": "msg",
  "speaker": "秋穂",
  "jp": "気になるのよ。\nルーは私たちの仲間だし。",
  "en": ""
 },
 {
  "id": "IVENT12:0007",
  "kind": "msg",
  "speaker": "秋穂",
  "jp": "あなたとルーは、友達じゃないの？",
  "en": ""
 },
 {
  "id": "IVENT12:0008",
  "kind": "msg",
  "speaker": "シャイ",
  "jp": "仲間に、友達か……昔のことよ。\n話す気はないわ。",
  "en": ""
 },
 {
  "id": "IVENT12:0009",
  "kind": "msg",
  "speaker": "シャイ",
  "jp": "それより練習よ。\nそんなことで\n時間をつぶしているヒマはないんだから。",
  "en": ""
 },
 {
  "id": "IVENT12:0010",
  "kind": "msg",
  "speaker": "秋穂",
  "jp": "<10>……ええ、わかったわ。",
  "en": ""
 },
 {
  "id": "IVENT12:0011",
  "kind": "msg",
  "speaker": "翔",
  "jp": "<10>……やっぱり、話しかけなくて\n正解だったかもしれないな。",
  "en": ""
 }
]
