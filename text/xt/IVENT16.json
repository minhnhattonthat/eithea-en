[
 {
  "id": "IVENT16:0000",
  "kind": "msg",
  "speaker": "翔",
  "jp": "（……ん、なんだ……？）",
  "en": ""
 },
 {
  "id": "IVENT16:0001",
  "kind": "msg",
  "speaker": "アルバイジャン",
  "jp": "……よう、翔。\nおこしちまったか？",
  "en": ""
 },
 {
  "id": "IVENT16:0002",
  "kind": "msg",
  "speaker": "翔",
  "jp": "アルバイジャン……\nなにしてるんだ？",
  "en": ""
 },
 {
  "id": "IVENT16:0003",
  "kind": "msg",
  "speaker": "アルバイジャン",
  "jp": "なにって、荷造りさ。\n明日中にカーライルに帰ろうと思ってな。",
  "en": ""
 },
 {
  "id": "IVENT16:0004",
  "kind": "msg",
  "speaker": "アルバイジャン",
  "jp": "さっきも言ったとおり、\nここだとブックの解読がこれ以上すすまないんだ。",
  "en": ""
 },
 {
  "id": "IVENT16:0005",
  "kind": "msg",
  "speaker": "アルバイジャン",
  "jp": "なぁ、やっぱり、おまえもいっしょに来るか？",
  "en": ""
 },
 {
  "id": "IVENT16:0006",
  "kind": "msg",
  "speaker": "翔",
  "jp": "遠慮しとくよ。",
  "en": ""
 },
 {
  "id": "IVENT16:0007",
  "kind": "msg",
  "speaker": "翔",
  "jp": "この村に慣れるだけで精一杯なのに、\n他のところに行って、うまくいくとは思えないし。",
  "en": ""
 },
 {
  "id": "IVENT16:0008",
  "kind": "msg",
  "speaker": "アルバイジャン",
  "jp": "そっか。\nま、無理にとは言わねえよ。",
  "en": ""
 },
 {
  "id": "IVENT16:0009",
  "kind": "msg",
  "speaker": "アルバイジャン",
  "jp": "おこしちまって、すまなかったな。",
  "en": ""
 },
 {
  "id": "IVENT16:0010",
  "kind": "msg",
  "speaker": "アルバイジャン",
  "jp": "カーライルに戻っても\nおまえ達の役に立つ事がわかったら連絡するからな。",
  "en": ""
 },
 {
  "id": "IVENT16:0011",
  "kind": "msg",
  "speaker": "翔",
  "jp": "ありがとう。",
  "en": ""
 },
 {
  "id": "IVENT16:0012",
  "kind": "msg",
  "speaker": "アルバイジャン",
  "jp": "先に寝ててくれ。\n俺はもう少し準備があるんでな。",
  "en": ""
 },
 {
  "id": "IVENT16:0013",
  "kind": "msg",
  "speaker": "翔",
  "jp": "じゃあ、でかけるか。",
  "en": ""
 }
]
