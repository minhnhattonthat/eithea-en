[
 {
  "id": "IVENT14:0000",
  "kind": "msg",
  "speaker": "翔",
  "jp": "あれ、ルー……",
  "en": ""
 },
 {
  "id": "IVENT14:0001",
  "kind": "msg",
  "speaker": "ルー",
  "jp": "あら、翔。",
  "en": ""
 },
 {
  "id": "IVENT14:0002",
  "kind": "msg",
  "speaker": "翔",
  "jp": "よく、ここに来るのかい？",
  "en": ""
 },
 {
  "id": "IVENT14:0003",
  "kind": "msg",
  "speaker": "ルー",
  "jp": "ええ。\nほら、ここからだと、\n村の全体が見渡せるでしょ？",
  "en": ""
 },
 {
  "id": "IVENT14:0004",
  "kind": "msg",
  "speaker": "ルー",
  "jp": "だから、好きなの。",
  "en": ""
 },
 {
  "id": "IVENT14:0005",
  "kind": "msg",
  "speaker": "翔",
  "jp": "そうか。\n確かにここは、いい眺めだよな。",
  "en": ""
 },
 {
  "id": "IVENT14:0006",
  "kind": "msg",
  "speaker": "ルー",
  "jp": "ねえ、翔<8>……\nおまえたちってさ、なんでああなの？",
  "en": ""
 },
 {
  "id": "IVENT14:0007",
  "kind": "msg",
  "speaker": "翔",
  "jp": "ああなのって、どういうことだ？",
  "en": ""
 },
 {
  "id": "IVENT14:0008",
  "kind": "msg",
  "speaker": "ルー",
  "jp": "ほら……おまえを呼び捨てにしたりとか、\n親しくしてたら、ユカ<8>が怒るじゃない。",
  "en": ""
 },
 {
  "id": "IVENT14:0009",
  "kind": "msg",
  "speaker": "ルー",
  "jp": "なんでそうなの？",
  "en": ""
 },
 {
  "id": "IVENT14:0010",
  "kind": "msg",
  "speaker": "翔",
  "jp": "なんでって……\nう～ん、うまく説明できないな。",
  "en": ""
 },
 {
  "id": "IVENT14:0011",
  "kind": "msg",
  "speaker": "ルー",
  "jp": "そうなの？",
  "en": ""
 },
 {
  "id": "IVENT14:0012",
  "kind": "msg",
  "speaker": "翔",
  "jp": "ああ、こればっかりはね。",
  "en": ""
 },
 {
  "id": "IVENT14:0013",
  "kind": "msg",
  "speaker": "ルー",
  "jp": "ふうん……\nなんだか、ややこしいのね。",
  "en": ""
 },
 {
  "id": "IVENT14:0014",
  "kind": "msg",
  "speaker": "翔",
  "jp": "そう言われてみると……\n確かに、そうかもしれないな。",
  "en": ""
 },
 {
  "id": "IVENT14:0015",
  "kind": "msg",
  "speaker": "ルー",
  "jp": "ややこしいよ。ぜったい。",
  "en": ""
 },
 {
  "id": "IVENT14:0016",
  "kind": "msg",
  "speaker": "翔",
  "jp": "う～ん……\nちょっと、他のところを散歩してくるよ。\nそれじゃ。",
  "en": ""
 },
 {
  "id": "IVENT14:0017",
  "kind": "msg",
  "speaker": "ルー",
  "jp": "ええ、またね。",
  "en": ""
 }
]
